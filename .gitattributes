* text=auto

# 仓库配置文件统一使用 LF，避免 Windows 换行警告
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.txt text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.jar binary
