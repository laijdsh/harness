application-local.properties
application-local.yml
.env

# 本地临时测试目录
.tmp-*/

# Python 生成脚本缓存
__pycache__/
*.pyc

# 用户提供的原始论文/开题报告（含个人信息，不提交公开仓库）
thesis/reference/
thesis/archive/论文初稿-桌面版-原始.docx
thesis/archive/论文初稿-19脚注版.docx
thesis/论文初稿-脚注原始.docx

